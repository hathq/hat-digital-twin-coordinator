  "properties": {
    "schema": {"const": "hathq://hat-digital-twin-coordinator/review-composition-input/v1"},
    "scope_ref": {"type": "string", "minLength": 1, "maxLength": 96},
    "revision": {"type": "integer", "minimum": 0},
